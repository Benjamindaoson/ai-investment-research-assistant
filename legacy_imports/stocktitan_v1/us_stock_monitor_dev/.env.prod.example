# -------------------------
# Production environment
# -------------------------

# Database
DB_PASSWORD=change_me
DB_PASSWORD_FILE=/run/secrets/db_password.txt

# OpenAI (final step)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_API_KEY_FILE=/run/secrets/openai_api_key.txt
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# MCP mail (optional if email tool is used)
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PASSWORD_FILE=/run/secrets/mail_password.txt

# API security (final step, required for production)
APP_SECURITY_ENABLED=true
APP_SECURITY_API_KEY_HEADER=X-API-KEY
APP_SECURITY_API_KEY=replace_with_strong_random_key
APP_SECURITY_API_KEY_FILE=/run/secrets/app_security_api_key.txt

# Redis (optional)
REDIS_PASSWORD_FILE=/run/secrets/redis_password.txt

# Gateway
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=8443
GATEWAY_NGINX_CONF=infra/nginx/nginx-tls.conf
