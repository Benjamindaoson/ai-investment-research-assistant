POSTGRES_DB=deepresearch
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=deepresearch
POSTGRES_PORT=5432
REDIS_PORT=6379
RUNTIME_PORT=8011

RESEARCH_RUNTIME_LEASE_SECONDS=300
RESEARCH_RUNTIME_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional comma-separated API keys. When set, every non-health /api/v1 route
# requires X-API-Key. Leave blank for local fixture development.
# Prefer DEEPRESEARCH_API_KEY_SHA256S in shared environments.
DEEPRESEARCH_API_KEYS=
DEEPRESEARCH_API_KEY_SHA256S=

# Optional operational request boundary.
# DEEPRESEARCH_MAX_BODY_BYTES rejects oversized request bodies before routing.
# DEEPRESEARCH_RATE_LIMIT_PER_MINUTE=0 disables the in-process limiter.
DEEPRESEARCH_MAX_BODY_BYTES=1000000
DEEPRESEARCH_RATE_LIMIT_PER_MINUTE=0

# Planner and synthesizer mode. Use deterministic for local fixture mode.
# Use llm only when the OpenAI-compatible variables below are configured.
DEEPRESEARCH_PLANNER=deterministic
DEEPRESEARCH_SYNTHESIZER=deterministic
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Leave blank for deterministic local evidence, or point to the separately
# running FinEvidence HTTP API. From a Compose container on Windows/macOS use:
# FIN_EVIDENCE_BASE_URL=http://host.docker.internal:8000
FIN_EVIDENCE_BASE_URL=
FIN_EVIDENCE_TIMEOUT_SECONDS=120
